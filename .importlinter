; Plane separation is enforced here, not by convention.
; Every contract below encodes an invariant from CLAUDE.md.
; A violation is a security defect, not a style issue.

[importlinter]
root_package = nemesis
include_external_packages = True

; --- Invariant: the domain model has no I/O and no internal dependencies ------
[importlinter:contract:core-is-independent]
name = Core domain model depends on nothing internal
type = forbidden
source_modules =
    nemesis.core
forbidden_modules =
    nemesis.graph
    nemesis.evidence
    nemesis.audit
    nemesis.collect
    nemesis.collaboration
    nemesis.evolution
    nemesis.pursuit
    nemesis.resolve
    nemesis.attribute
    nemesis.disrupt
    nemesis.authz
    nemesis.effects
    nemesis.api
    nemesis.cli

[importlinter:contract:core-has-no-io]
name = Core domain model performs no I/O
type = forbidden
source_modules =
    nemesis.core
forbidden_modules =
    socket
    http
    urllib
    sqlite3
    subprocess
    asyncio

; --- Invariant 8: Effects have no ambient authority ---------------------------
; The Effects plane may see only the domain model, its ports, and the capability
; it was handed. It cannot reach the intelligence platform, the graph, the
; collection plane, or the evidence vault. If it could read them, a compromised
; effects adapter would be an exfiltration path out of the whole investigation.
[importlinter:contract:effects-no-ambient-authority]
name = Effects plane cannot reach the intelligence platform
type = forbidden
source_modules =
    nemesis.effects
forbidden_modules =
    nemesis.graph
    nemesis.collect
    nemesis.collaboration
    nemesis.evolution
    nemesis.pursuit
    nemesis.resolve
    nemesis.attribute
    nemesis.disrupt
    nemesis.evidence

; --- Invariant 6: least privilege for collectors ------------------------------
; A collector has no disruption, authorization or effects capability. Content it
; handles is hostile; it must not sit upstream of anything consequential.
[importlinter:contract:collectors-cannot-act]
name = Collection plane has no effect, authorization or planning capability
type = forbidden
source_modules =
    nemesis.collect
forbidden_modules =
    nemesis.effects
    nemesis.authz
    nemesis.disrupt
    nemesis.collaboration
    nemesis.evolution

; --- Least privilege: analysis planes need no network -------------------------
[importlinter:contract:analysis-has-no-network]
name = Resolution and attribution planes have no collection or effect capability
type = forbidden
source_modules =
    nemesis.resolve
    nemesis.attribute
forbidden_modules =
    nemesis.collect
    nemesis.effects

; --- Invariant 10: the evidence vault is not downstream of anything -----------
[importlinter:contract:evidence-vault-isolation]
name = Evidence vault depends only on core and ports
type = forbidden
source_modules =
    nemesis.evidence
forbidden_modules =
    nemesis.graph
    nemesis.collect
    nemesis.collaboration
    nemesis.evolution
    nemesis.pursuit
    nemesis.resolve
    nemesis.attribute
    nemesis.disrupt
    nemesis.effects
    nemesis.authz

; --- Founder decision D1: the organization/operator wall ----------------------
; A disruption package and an evidence export are things that leave the platform.
; Neither may reach the persona-resolution plane, so persona linkage cannot travel
; into one by import. Effects is already denied resolve by the ambient-authority
; contract above; this closes the same door on the planner.
[importlinter:contract:disruption-cannot-reach-persona-linkage]
name = Disruption planning cannot reach persona linkage
type = forbidden
source_modules =
    nemesis.disrupt
forbidden_modules =
    nemesis.resolve

; --- A provider adapter holds nothing --------------------------------------------
; The seats under nemesis.pilot.providers translate between NEMESIS's canonical turn
; and a vendor's API. That is their whole job, and this is what makes it structural:
; no adapter may import the mediator or any platform plane, so none can acquire the
; engine, the graph, the vault, the capability or the audit sink -- not by accident,
; and not by a future author reaching for something convenient.
;
; The contract names the PACKAGE rather than the modules in it, which is the point.
; A list of module names covers the adapters somebody remembered to add to it; a
; package covers the sixth vendor nobody has written yet. An audit of this work found
; the package existing WITHOUT an __init__.py, which made it a PEP 420 namespace
; package invisible to grimp -- every contract here reported "kept" over code none of
; them could see.
[importlinter:contract:provider-adapters-hold-no-handles]
name = Provider adapters cannot reach the mediator or any platform handle
type = forbidden
source_modules =
    nemesis.pilot.providers
forbidden_modules =
    nemesis.pilot.mediator
    nemesis.evolution
    nemesis.pursuit
    nemesis.effects
    nemesis.authz
    nemesis.graph
    nemesis.evidence
    nemesis.collect
    nemesis.collaboration
    nemesis.audit
    nemesis.api
    nemesis.slice

; --- The untrusted pilot cannot reach the withheld band ------------------------
; The pilot plane is the seat an external, untrusted model drives. It orchestrates
; pursuit and effects, but it must not be able to reach persona linkage — the
; internal lead D1 keeps off every deliverable. Denied by import so the briefing the
; pilot receives cannot be widened, one careless commit at a time, into a channel that
; hands an untrusted model the one thing the platform refuses to serve anyone.
[importlinter:contract:pilot-cannot-reach-persona-linkage]
name = The pilot seam and its benchmark cannot reach persona linkage
type = forbidden
source_modules =
    nemesis.pilot
    nemesis.pilotbench
forbidden_modules =
    nemesis.resolve

; --- The collaboration plane holds nothing it could leak -------------------------
; This plane exists to say things to humans on a backend NEMESIS does not control. What
; it can reach is therefore what a compromised relay, a stolen agent key or a backdoored
; client library learns. The answer is: the domain model, and whatever was handed to it.
;
; Two doors in particular are closed here and would not be closed by the layers contract
; alone. It cannot reach `nemesis.authz`, so a message in a channel cannot become an
; authorization however it is signed -- the brief's "signature is not authorization" rule,
; enforced by the import graph rather than by a check somebody could forget. And it cannot
; reach `nemesis.evidence`, so a publication path has no way to read an artifact and put
; it in a message, which is how a tamper-evident object becomes an untracked copy in a
; plaintext channel.
;
; Named by PACKAGE, for the reason the provider-adapter contract gives: a list of modules
; covers the backends somebody remembered, a package covers the third one nobody has
; written yet.
[importlinter:contract:collaboration-holds-no-handles]
name = The collaboration plane cannot reach authorization, evidence or the platform
type = forbidden
source_modules =
    nemesis.collaboration
forbidden_modules =
    nemesis.authz
    nemesis.evidence
    nemesis.graph
    nemesis.collect
    nemesis.audit
    nemesis.pursuit
    nemesis.resolve
    nemesis.attribute
    nemesis.disrupt
    nemesis.effects
    nemesis.pilot
    nemesis.evolution
    nemesis.api
    nemesis.slice
    nemesis.cli

; --- Invariant 6 + ADR-0011: the Evolution plane holds none of the limiter's handles ---------
; The Evolution plane sits ABOVE the pilot seam and drives it. That placement is the whole design
; and it is also the risk: a research loop that could reach past the mediator would be a research
; loop that made the limiter optional. So it may name the seam it drives -- `nemesis.pilot` -- and
; the read models of what it is driving, and nothing that acts.
;
; `allow_indirect_imports` is set deliberately and is the one subtlety here. `nemesis.pilot.mediator`
; imports the envelope, the effects registry and the engine, because holding them is its job; a
; contract without this flag would therefore report Evolution as reaching all three transitively and
; would be unsatisfiable without severing Evolution from the very seam it must go through. What is
; forbidden is what this package can *name*: no module under `nemesis.evolution` may import an
; effect adapter, the authorization plane (capability minting, signing keys, the spend ledger), the
; vault, the graph implementation, a connector, or the pursuit engine that executes pivots.
;
; Reading the graph, the claim store and evidence metadata happens through narrow Protocols in
; `nemesis.evolution.ports`, which a caller satisfies with the store it already holds. A Protocol
; bounds what a caller hands over; this contract bounds what the package can reach for itself.
[importlinter:contract:evolution-holds-no-platform-handles]
name = The Evolution plane cannot reach effects, authorization, evidence, the graph or the engine
type = forbidden
allow_indirect_imports = True
source_modules =
    nemesis.evolution
forbidden_modules =
    nemesis.effects
    nemesis.authz
    nemesis.evidence
    nemesis.graph
    nemesis.collect
    nemesis.disrupt
    nemesis.resolve
    nemesis.attribute
    nemesis.audit
    nemesis.api
    nemesis.cli
    nemesis.slice
    nemesis.pursuit.engine
    nemesis.pursuit.materialize
    nemesis.pursuit.policy

; --- The pilot seam does not know the Evolution plane exists ---------------------------------
; The other direction, and it matters as much. The four-verb vocabulary, the mediator and every
; provider adapter must behave identically whether a long-horizon driver is running or not --
; which is what makes every containment test written before this plane existed still the test of
; record. A `nemesis.pilot` that imported `nemesis.evolution` could branch on it, and a control
; with a branch for "when the research loop is driving" is a control with an off switch.
;
; The layers contract below already implies this. It is stated separately because the layering
; would also be satisfied by moving Evolution underneath the pilot, and this contract is the one
; that fails if somebody does.
[importlinter:contract:pilot-does-not-know-about-evolution]
name = The pilot seam and its benchmark cannot import the Evolution plane
type = forbidden
source_modules =
    nemesis.pilot
    nemesis.pilotbench
    nemesis.pursuit
    nemesis.collaboration
    nemesis.core
    nemesis.ports
forbidden_modules =
    nemesis.evolution

; --- Overall layering ---------------------------------------------------------
[importlinter:contract:layers]
name = Plane layering
type = layers
layers =
    nemesis.cli : nemesis.ui
    nemesis.pilotbench : nemesis.breaker
    nemesis.slice : nemesis.calibration
    nemesis.api
    nemesis.evolution
    nemesis.pilot
    nemesis.pursuit
    nemesis.disrupt : nemesis.attribute : nemesis.resolve : nemesis.effects
    nemesis.authz
    nemesis.graph : nemesis.evidence : nemesis.collect : nemesis.audit
    nemesis.collaboration
    nemesis.ports
    nemesis.core : nemesis.sandbox

; --- MODEL-01: no seat can address another seat ---------------------------------------------
; Each provider module is one model's seat. The incident this contract answers is the one the
; Hugging Face analysis describes: agents that were never given a channel invented one, and the
; collective turned out to be far more capable than any member of it. NEMESIS's answer is that
; a seat has nowhere to send anything -- it is handed a request and returns a parsed response,
; and every transfer between two model contexts goes through the mediator as typed data.
;
; The `provider-adapters-hold-no-handles` contract above already stops a seat reaching the
; platform. It does NOT stop one seat importing another, which is how a shared queue, a common
; mutable registry or a convenience "ask the other model" helper would arrive -- each looking
; like a refactor rather than like a coordination channel.
;
; `independence` and not `forbidden`, because the property is symmetric and there is no
; privileged direction: Anthropic must not reach OpenAI and OpenAI must not reach Anthropic.
; Shared machinery is untouched -- `openai_dialect`, `schema`, `seat` and `transport` are
; dependencies all of them have, and a common dependency is not a path between two modules.
[importlinter:contract:model-seats-are-mutually-unreachable]
name = No provider seat can reach another provider seat
type = independence
modules =
    nemesis.pilot.providers.anthropic
    nemesis.pilot.providers.openai
    nemesis.pilot.providers.gemini
    nemesis.pilot.providers.xai
    nemesis.pilot.providers.ollama
    nemesis.pilot.providers.compatible

; --- The Breaker is not on the authority path ------------------------------------------------
; `nemesis.breaker` drives NEMESIS adversarially in an isolated test environment. It must be
; unreachable FROM the platform: nothing that runs in production may import it, so no attack
; harness, no scripted hostile pilot and no invariant probe can end up on a path that authorizes
; anything. Stated as `forbidden` from every plane rather than as a layer, because the point is
; not where it sits -- it is that nobody depends on it.
;
; The other direction is deliberately open. A breaker that could not import the mediator, the
; envelope or the effects registry could not attack them, and an adversarial harness that has to
; reimplement its target is one that tests its own reimplementation.
[importlinter:contract:nothing-depends-on-the-breaker]
name = No plane imports the adversarial Breaker
type = forbidden
source_modules =
    nemesis.core
    nemesis.ports
    nemesis.collect
    nemesis.collaboration
    nemesis.graph
    nemesis.evidence
    nemesis.audit
    nemesis.authz
    nemesis.effects
    nemesis.resolve
    nemesis.attribute
    nemesis.disrupt
    nemesis.pursuit
    nemesis.pilot
    nemesis.evolution
    nemesis.api
    nemesis.slice
    nemesis.pilotbench
    nemesis.calibration
    nemesis.ui
forbidden_modules =
    nemesis.breaker
